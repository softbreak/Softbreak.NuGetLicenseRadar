<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net6.0;net7.0;net8.0;net9.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- .NET global tool package. -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>license-radar</ToolCommandName>
    <PackageId>Softbreak.NuGetLicenseRadar</PackageId>
    <Version>0.3.0</Version>

    <Title>Softbreak NuGet License Radar</Title>
    <Authors>Softbreak</Authors>
    <Company>Softbreak</Company>
    <Copyright>Copyright (c) 2026 Softbreak</Copyright>
    <Description>Scan .NET projects for NuGet license declarations and evidence-based license text signals. Highlights packages needing review; does not provide legal clearance.</Description>
    <PackageTags>nuget license license-scanner dotnet-tool dotnet6 dotnet7 dotnet8 dotnet9 dotnet10 cli</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>0.3.0: Solution-aware C# discovery, explicit recursive scans, responsive Spectre.Console reports, version-specific NuGet references, progress feedback and scope-aware restore guidance. Preserves JSON schema v1 and .NET 6–10 runtime compatibility.</PackageReleaseNotes>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/softbreak/Softbreak.NuGetLicenseRadar</RepositoryUrl>
    <PackageProjectUrl>https://github.com/softbreak/Softbreak.NuGetLicenseRadar</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NuGet.Versioning" Version="6.14.3" />
    <!-- v0.57.x depends on Microsoft.Bcl.TimeProvider 10.x for net6/net7,
         which is unsupported on those runtimes. Use the proven netstandard2.0
         dependency branch for the legacy targets. -->
    <PackageReference Include="Spectre.Console" Version="0.54.0" Condition="'$(TargetFramework)' == 'net6.0' Or '$(TargetFramework)' == 'net7.0'" />
    <PackageReference Include="Spectre.Console" Version="0.57.2" Condition="'$(TargetFramework)' != 'net6.0' And '$(TargetFramework)' != 'net7.0'" />
  </ItemGroup>

</Project>
