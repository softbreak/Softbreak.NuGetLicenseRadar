<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- .NET global tool package. -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>license-radar</ToolCommandName>
    <PackageId>Softbreak.NuGetLicenseRadar</PackageId>
    <Version>0.1.1</Version>

    <Title>Softbreak NuGet License Radar</Title>
    <Authors>Softbreak</Authors>
    <Company>Softbreak</Company>
    <Copyright>Copyright (c) 2026 Softbreak</Copyright>
    <Description>Scan .NET projects for NuGet license declarations and evidence-based license text signals. Highlights packages needing review; does not provide legal clearance.</Description>
    <PackageTags>nuget license license-scanner dotnet-tool dotnet10 cli</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>0.1.1: Fix NuGet packages.lock.json parsing for multi-project solutions. Project references without resolved package versions are skipped; malformed package entries now produce contextual errors.</PackageReleaseNotes>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/softbreak/Softbreak.NuGetLicenseRadar</RepositoryUrl>
    <PackageProjectUrl>https://github.com/softbreak/Softbreak.NuGetLicenseRadar</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NuGet.Versioning" Version="7.9.0" />
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
  </ItemGroup>

</Project>
